# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase dashboard > your project > Connect (or Project Settings > API Keys).

# Used by the app (safe for the browser). Also add both to Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Only for `npm run seed` / `npm run unseed` on your own computer.
# The secret key (sb_secret_...) bypasses all security: never add it to Vercel,
# never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
